# The deployed FastAPI API. Override with http://127.0.0.1:8000 only when
# running the backend locally.
NEXT_PUBLIC_API_URL=https://social9-backend-2tjj.onrender.com
NEXT_PUBLIC_SITE_URL=https://www.social9.io
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false

# Leave empty until the Android app is live on Google Play.
NEXT_PUBLIC_ANDROID_APP_URL=

# Rebuild after enabling shared registration/sign-in with the connected backend.
NEXT_PUBLIC_ECOSYSTEM_SSO_ENABLED=false
